# ── Barangay AI · Non-secret configuration template ─────────────────────────
# Copy to `.env` locally. NEVER commit real credentials.

# AI service endpoints (used by Docker Compose and Next.js route handlers)
AI_PDF_SERVICE_URL=http://localhost:8001
AI_TRANSLATION_SERVICE_URL=http://localhost:8002
AI_TTS_SERVICE_URL=http://localhost:8003

# PDF Processor
PDF_MAX_BYTES=26214400
PDF_DOWNLOAD_TIMEOUT_SECONDS=30
PDF_EXTRACTION_TIMEOUT_SECONDS=180
PDF_RATE_LIMIT_PER_MINUTE=20

# Translation service (Lingvanex/ctranslate2)
TRANSLATION_MODEL_ROOT=./models
TRANSLATION_DEVICE=cpu
TRANSLATION_COMPUTE_TYPE=int8
TRANSLATION_MAX_TEXT_LENGTH=1000
TRANSLATION_RATE_LIMIT_PER_MINUTE=60

# TTS service (F5-TTS)
TTS_MODEL_NAME=F5TTS_v1_Base
TTS_MODEL_PATH=
TTS_DEVICE=cpu
TTS_OUTPUT_DIR=./output
TTS_MAX_TEXT_LENGTH=1000
TTS_AUDIO_RETENTION_HOURS=24
TTS_PUBLIC_BASE_URL=
TTS_RATE_LIMIT_PER_MINUTE=30
# Reference voice prompt (required by F5-TTS)
TTS_REF_AUDIO=
TTS_REF_TEXT=
TTS_REF_AUDIO_URL=

# Frontend feature flag (enables AI service call-outs in the resident PWA)
NEXT_PUBLIC_AI_SERVICES_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
