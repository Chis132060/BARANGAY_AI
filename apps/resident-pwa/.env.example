NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only Gemini TTS configuration for /api/tts.
# Never prefix these with NEXT_PUBLIC_ or expose them to the browser.
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_TTS_MODEL=gemini-2.5-pro-preview-tts
GEMINI_TTS_VOICE=Umbriel

# Firebase Cloud Messaging VAPID key for push notifications
NEXT_PUBLIC_FCM_VAPID_KEY=your-fcm-vapid-key


# Server-only OpenAI Agents SDK configuration for /api/chat.
# Never prefix these with NEXT_PUBLIC_ or expose them to the browser.
OPENAI_API_KEY=your_openai_api_key
OPENAI_AGENT_ENABLED=false
OPENAI_AGENT_MODEL=gpt-4.1-mini

# Standard browser Web Push VAPID public key (client) and private key (server only).
# Must be a matched pair; do not reuse Firebase project keys unless intentionally identical.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
