NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_MOCK_SUPABASE=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only Gemini TTS configuration for /api/tts.
# Never prefix these with NEXT_PUBLIC_ or expose them to the browser.
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_TTS_MODEL=gemini-2.5-pro-preview-tts
GEMINI_TTS_VOICE=Umbriel

# Firebase Cloud Messaging VAPID key for push notifications
NEXT_PUBLIC_FCM_VAPID_KEY=your-fcm-vapid-key

# Local development mock auth. Keep false when using real Supabase Auth.
NEXT_PUBLIC_MOCK_SUPABASE=false
NEXT_PUBLIC_MOCK_RESIDENT_EMAIL=resident@barangay.gov
NEXT_PUBLIC_MOCK_RESIDENT_PASSWORD=password123
