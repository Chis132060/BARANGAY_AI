# ── Barangay AI · PDF Processor ──────────────────────────────────────────────
# Copy to `.env` next to the service (or the repo root `.env`) and adjust.

# Maximum PDF file size in bytes (25 MB default)
PDF_MAX_BYTES=26214400

# Timeouts (seconds)
PDF_DOWNLOAD_TIMEOUT_SECONDS=30
PDF_EXTRACTION_TIMEOUT_SECONDS=180

# Rate limiting: requests per client IP per minute
PDF_RATE_LIMIT_PER_MINUTE=20

# Service port (Docker maps the container's 8000 internally)
PDF_SERVICE_PORT=8000