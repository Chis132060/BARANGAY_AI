# ── Barangay AI · TTS service ────────────────────────────────────────────────
# Copy to `.env` and adjust.

# F5-TTS model name (HuggingFace) or a local checkpoint path
TTS_MODEL_NAME=F5TTS_v1_Base
TTS_MODEL_PATH=

# Device: cpu (default) | cuda | auto. Falls back to cpu automatically.
TTS_DEVICE=cpu

# Generated audio location + retention
TTS_OUTPUT_DIR=./output
TTS_AUDIO_RETENTION_HOURS=24

# Reference voice prompt required by F5-TTS
TTS_REF_AUDIO=
TTS_REF_TEXT=
TTS_REF_AUDIO_URL=

# Public base URL used to build audio links (leave empty to derive from request)
TTS_PUBLIC_BASE_URL=

# Input limits & rate limiting
TTS_MAX_TEXT_LENGTH=1000
TTS_RATE_LIMIT_PER_MINUTE=30

TTS_SERVICE_PORT=8000