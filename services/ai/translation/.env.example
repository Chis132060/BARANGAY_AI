# ── Barangay AI · Translation service ───────────────────────────────────────
# Copy to `.env` and adjust.

# Directory that holds per-direction model folders, e.g. ./models/en_ceb/ <model.bin, en.spm.model, ceb.spm.model>
TRANSLATION_MODEL_ROOT=./models

# Device: cpu (default) | cuda | auto. Falls back to cpu automatically.
TRANSLATION_DEVICE=cpu
TRANSLATION_COMPUTE_TYPE=int8

# Input limits & rate limiting
TRANSLATION_MAX_TEXT_LENGTH=1000
TRANSLATION_RATE_LIMIT_PER_MINUTE=60

TRANSLATION_SERVICE_PORT=8000